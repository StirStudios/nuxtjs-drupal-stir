{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stirstudios.dev/contracts/v1/page-summaries.schema.json",
  "title": "Stir page summaries response",
  "type": "array",
  "maxItems": 25,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path", "title", "description"],
    "properties": {
      "path": { "type": "string", "pattern": "^/" },
      "title": { "type": "string" },
      "description": { "type": ["string", "null"] }
    }
  }
}
